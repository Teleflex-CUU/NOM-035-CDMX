//  BUSCAR EMPLEADO
// ══════════════════════════════════════════════════
function buscarEmpleado() {
  const noemp = document.getElementById('inp-noemp').value.trim();
  const err   = document.getElementById('inicio-error');
  const box   = document.getElementById('emp-info-box');
  const btn   = document.getElementById('btn-iniciar');
  err.style.display='none'; box.style.display='none'; btn.style.display='none';

  if(!noemp){ err.textContent='Ingresa tu número de empleado.'; err.style.display='block'; return; }

  const emp = HC.find(e=>String(e.noemp)===noemp);
  if(!emp){ err.textContent='Número de empleado no encontrado. Verifica e intenta de nuevo.'; err.style.display='block'; return; }

  empleado = emp;
  box.innerHTML = `<strong>${emp.nombre}</strong><br>Puesto: ${emp.puesto||'—'}<br>Departamento: ${emp.dept||'—'}<br>Planta: ${emp.planta||'—'}`;
  box.style.display='block';
  btn.style.display='block';
}

document.getElementById('inp-noemp').addEventListener('keydown', e=>{ if(e.key==='Enter') buscarEmpleado(); });

