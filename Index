  });
}

// ══════════════════════════════════════════════════
//  RENDER SECCIÓN
// ══════════════════════════════════════════════════
function renderSeccion() {
  const sec = secciones[secIdx];
  if(!sec) { enviarEncuesta(); return; }

  const total   = secciones.length;
  const pct     = Math.round(10 + (secIdx/total)*85);
  setProgress(pct);

  const el = document.getElementById('sec-content');

  // Secciones opcionales (pregunta si/no)
  if(sec.type==='pregunta-opcional') {
    el.innerHTML = `
    <div class="card">
      <div class="card-title">${sec.name}</div>
      <div class="card-desc">${sec.desc}</div>
      <div class="opt-toggle">
        <div class="toggle-btns">
          <button class="toggle-btn ${getOpcional(sec.id)==='si'?'active':''}" onclick="setOpcional('${sec.id}','si')">Sí</button>
          <button class="toggle-btn ${getOpcional(sec.id)==='no'?'active':''}" onclick="setOpcional('${sec.id}','no')">No</button>
        </div>
      </div>
      <div id="opc-pregs" style="display:${getOpcional(sec.id)==='si'?'block':'none'}">
        ${renderPregs(sec.nums, sec.guia)}
      </div>
      <div class="nav-btns">
        <button class="btn btn-outline" onclick="prevSec()">← Anterior</button>
        <button class="btn btn-navy" onclick="nextSec()">Siguiente →</button>
      </div>
    </div>`;
    return;
  }

  // Sección normal de preguntas
  const guia   = sec.phase==='g2' ? 2 : 3;
  const title  = guia===2 ? 'Guía II' : 'Guía III';
  const qStart = sec.nums[0];
  const qEnd   = sec.nums[sec.nums.length-1];

  el.innerHTML = `
  <div class="card">
    <div class="sec-hdr">
      <h3>${sec.name}</h3>
      <p>${sec.desc}</p>
      <div class="sec-counter">${title} · Preguntas ${qStart}–${qEnd}</div>
    </div>
    <div class="scale-labels">
      ${OPTS.map(o=>`<div class="scale-lbl">${o}</div>`).join('')}
    </div>
    ${renderPregs(sec.nums, guia)}
    <div class="nav-btns">
      ${secIdx>0?'<button class="btn btn-outline" onclick="prevSec()">← Anterior</button>':'<div></div>'}
      <button class="btn btn-navy" onclick="nextSec()">${secIdx===secciones.length-1?'Finalizar ✓':'Siguiente →'}</button>
    </div>
  </div>`;
}

function renderPregs(nums, guia) {
  return nums.map((num,i)=>{
    const q0    = num-1;
    const sec   = guia<=3 ? G2_SECCIONES.concat(G3_SECCIONES).find(s=>s.nums&&s.nums.includes(num)) : null;
    const qtext = (guia===2||guia===23)
      ? (G2_SECCIONES.flatMap(s=>s.qs.map((q,j)=>{return{num:s.nums[j],text:q}})).find(q=>q.num===num)||{text:''}).text
      : (G3_SECCIONES.flatMap(s=>s.qs.map((q,j)=>{return{num:s.nums[j],text:q}})).find(q=>q.num===num)||{text:''}).text;
    const ans  = guia===2||guia===23 ? g2Ans : g3Ans;
    // Para opcionales G3 (65-72) también usar g3Ans
    const actualAns = guia===33 ? g3Ans : ans;
    const actualGuia = guia>3 ? (guia===23?2:3) : guia;

    return `<div${i>0?` style="border-top:1px solid var(--border);margin-top:12px;padding-top:12px"`:``}>
      <div class="q-num">Pregunta ${num}</div>
      <div class="q-text">${qtext}</div>
      <div class="q-opts">
        ${OPTS.map((opt,oi)=>`<button class="q-opt${actualAns[q0]!==undefined&&scored(oi,q0,actualGuia)===actualAns[q0]?' sel':''}"
          onclick="answerQ(${num},${oi},${actualGuia})">${opt}</button>`).join('')}
      </div>
    </div>`;
  }).join('');
}

function getOpcional(id) {
  if(id==='clientes-q'||id==='clientes-g3') return tieneClientes;
  if(id==='supervisor-q'||id==='supervisor-g3') return esSupervisor;
  return null;
}

function setOpcional(id, val) {
  if(id==='clientes-q'||id==='clientes-g3') tieneClientes=val;
  if(id==='supervisor-q'||id==='supervisor-g3') esSupervisor=val;
  document.querySelector('.toggle-btns .toggle-btn:first-child').classList.toggle('active',val==='si');
  document.querySelector('.toggle-btns .toggle-btn:last-child').classList.toggle('active',val==='no');
  document.getElementById('opc-pregs').style.display = val==='si'?'block':'none';
}

// ══════════════════════════════════════════════════
//  RESPONDER PREGUNTA
// ══════════════════════════════════════════════════
function answerQ(num, oi, guia) {
  const q0  = num-1;
  const val = scored(oi, q0, guia);
  if(guia===2||guia===23) g2Ans[q0] = val;
  else g3Ans[q0] = val;

  // Actualizar visual
  const sec    = secciones[secIdx];
  const allBtns = document.querySelectorAll(`.q-opts`);
  const qIdx   = (sec.nums||[]).indexOf(num);
  if(qIdx>=0 && allBtns[qIdx]) {
    allBtns[qIdx].querySelectorAll('.q-opt').forEach((b,i)=>{
      b.classList.toggle('sel', scored(i,q0,guia)===val);
    });
  }
}

// ══════════════════════════════════════════════════
//  NAVEGACIÓN
// ══════════════════════════════════════════════════
function nextSec() {
  const sec = secciones[secIdx];
  // Validar que todas las preguntas estén contestadas
  const nums = sec.nums||[];
  if(nums.length>0) {
    const opt = getOpcional(sec.id);
    if(opt==='si' || opt===null) {
      const guia = (sec.phase==='g2'||sec.guia===2||sec.guia===23) ? 2 : 3;
      const ans  = guia===2 ? g2Ans : g3Ans;
      const sin  = nums.filter(n=>ans[n-1]===undefined);
      if(sin.length>0) {
        toast(`Faltan ${sin.length} pregunta(s) por responder`);
        return;
      }
    }
  }
  secIdx++;
  renderSeccion();
  window.scrollTo(0,0);
}

function prevSec() {
  if(secIdx>0) { secIdx--; renderSeccion(); window.scrollTo(0,0); }
}

// ══════════════════════════════════════════════════
//  CALCULAR SCORES
// ══════════════════════════════════════════════════
function calcScores() {
  // G2 scores por categoría
  const g2cats = {};
  for(const [cat, nums] of Object.entries(G2_CATS)) {
    g2cats[cat] = nums.reduce((s,n)=>s+(g2Ans[n-1]||0),0);
  }
  // Agregar opcionales si aplica
  if(tieneClientes==='si') {
    g2cats.catFactores = (g2cats.catFactores||0) + [41,42,43].reduce((s,n)=>s+(g2Ans[n-1]||0),0);
  }
  if(esSupervisor==='si') {
    g2cats.catLiderazgo = (g2cats.catLiderazgo||0) + [44,45,46].reduce((s,n)=>s+(g2Ans[n-1]||0),0);
  }
  const g2score = Object.values(g2cats).reduce((a,b)=>a+b,0);
  const g2nivel = nivelG2(g2score);

  // G3 scores por categoría
  const g3cats = {};
  for(const [cat, nums] of Object.entries(G3_CATS)) {
    g3cats[cat] = nums.reduce((s,n)=>s+(g3Ans[n-1]||0),0);
  }
  if(tieneClientes==='si') {
    g3cats.catFactores3 = (g3cats.catFactores3||0) + [65,66,67,68].reduce((s,n)=>s+(g3Ans[n-1]||0),0);
  }
  if(esSupervisor==='si') {
    g3cats.catLid3 = (g3cats.catLid3||0) + [69,70,71,72].reduce((s,n)=>s+(g3Ans[n-1]||0),0);
  }
  const g3score = Object.values(g3cats).reduce((a,b)=>a+b,0);
  const g3nivel = nivelG3(g3score);

  // ATS
  const sec1Keys  = ATS_SEC1.map((_,i)=>`s1_${i}`);
  const algSiSec1 = sec1Keys.some(k=>atsAns[k]==='si');
  const atencionATS = algSiSec1 ? evaluarATS() : 'No requiere';

  return { g2score, g2nivel, g2cats, g3score, g3nivel, g3cats, atencionATS };
}

function evaluarATS() {
  const sec2 = ATS_SEC2.some((_,i)=>atsAns[`s2_${i}`]==='si');
  const sec3 = ATS_SEC3.filter((_,i)=>atsAns[`s3_${i}`]==='si').length >= 3;
  const sec4 = ATS_SEC4.filter((_,i)=>atsAns[`s4_${i}`]==='si').length >= 2;
  return (sec2||sec3||sec4) ? 'Requiere atención clínica' : 'No requiere';
}

// ══════════════════════════════════════════════════
//  ENVIAR ENCUESTA
// ══════════════════════════════════════════════════
async function enviarEncuesta() {
  const scores = calcScores();
  const ts     = new Date().toISOString();
  const fecha  = new Date().toLocaleDateString('es-MX');

  const base = {
    ts, fecha,
    noemp: empleado.noemp, nombre: empleado.nombre,
    puesto: empleado.puesto, categoria: empleado.categoria,
    genero: '', edad: '',
    dept: empleado.dept, subdept: empleado.subdept||'',
    planta: 'México City', turno: 'Diurno',
    supervisor: '', ingreso: '', imss: '',
    manual: 'N'
  };

  const payloadG2 = {
    action:'saveGRII', ...base,
    score: scores.g2score, nivel: scores.g2nivel,
    ...scores.g2cats
  };

  const payloadG3 = {
    action:'saveGRIII', ...base,
    score: scores.g3score, nivel: scores.g3nivel,
    catLiderazgo:    scores.g3cats.catLid3||0,
    catRelaciones:   scores.g3cats.catLid3||0,
    catParticipacion:scores.g3cats.catOrg3||0,
    catDistribucion: scores.g3cats.catEntorno3||0,
    catCapacitacion: scores.g3cats.catFactores3||0,
  };

  const payloadATS = {
    action:'saveGRI', ...base,
    tipoEvento: 'ATS', fechaEvento: fecha,
    rol: atsAns.s1_5==='si'?'Afectado':'Testigo',
    descripcion: '', sentimiento: '', atencion: scores.atencionATS,
  };

  show('screen-gracias');
  setProgress(100);

  // Enviar en background
  const send = async (payload) => {
    const params = new URLSearchParams(payload);
    await fetch(GAS_URL+'?'+params.toString(), {method:'GET',redirect:'follow'});
  };

  try {
    await send(payloadG2);
    await send(payloadG3);
    // ATS solo si hubo acontecimiento
    const algSi = ATS_SEC1.some((_,i)=>atsAns[`s1_${i}`]==='si');
    if(algSi) await send(payloadATS);
  } catch(e) {
    console.warn('Error de envío:', e);
  }
}
</script>
