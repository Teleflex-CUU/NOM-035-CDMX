<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#0D2B5A;--teal:#00796B;--white:#fff;--bg:#F0F4FA;
  --text:#0F172A;--text2:#475569;--text3:#94A3B8;
  --border:#E2E8F0;--red:#DC2626;--green:#16A34A;
  --r:10px;--font:system-ui,-apple-system,sans-serif;
}
body{font-family:var(--font);background:var(--bg);color:var(--text);min-height:100vh}

/* HEADER */
.hdr{background:var(--navy);color:#fff;padding:14px 20px;display:flex;align-items:center;justify-content:space-between}
.hdr-title{font-size:15px;font-weight:700}
.hdr-sub{font-size:11px;color:rgba(255,255,255,.6);margin-top:2px}
.hdr-right{text-align:right;font-size:11px;color:rgba(255,255,255,.6)}

/* PROGRESS */
.prog-wrap{background:rgba(255,255,255,.15);height:4px}
.prog-bar{height:4px;background:#38BDF8;transition:width .4s ease}

/* CONTAINER */
.container{max-width:680px;margin:0 auto;padding:20px 16px}

/* CARD */
.card{background:var(--white);border-radius:var(--r);border:1px solid var(--border);padding:20px;margin-bottom:16px}
.card-title{font-size:14px;font-weight:700;color:var(--navy);margin-bottom:4px}
.card-desc{font-size:12px;color:var(--text2);margin-bottom:16px;line-height:1.5}

/* EMPLEADO */
.emp-row{display:flex;gap:10px;align-items:flex-end;margin-bottom:12px}
.inp-group{flex:1}
.inp-group label{font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.7px;display:block;margin-bottom:4px}
.inp{width:100%;padding:10px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:14px;font-family:var(--font);transition:border .15s}
.inp:focus{outline:none;border-color:var(--navy)}
.emp-info{background:var(--bg);border-radius:8px;padding:10px 14px;font-size:13px;line-height:1.7;margin-bottom:12px;border:1px solid var(--border)}
.emp-info strong{color:var(--navy)}

/* PREGUNTA */
.q-num{font-size:10px;font-weight:700;color:var(--text3);margin-bottom:4px}
.q-text{font-size:14px;color:var(--text);line-height:1.5;margin-bottom:12px;font-weight:500}
.q-opts{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.q-opt{padding:8px 4px;border:1.5px solid var(--border);border-radius:8px;text-align:center;cursor:pointer;font-size:11px;color:var(--text2);transition:all .15s;background:var(--white)}
.q-opt:hover{border-color:var(--navy);color:var(--navy)}
.q-opt.sel{border-color:var(--navy);background:var(--navy);color:#fff;font-weight:700}
.q-sep{height:1px;background:var(--border);margin:14px 0}

/* SECCION HEADER */
.sec-hdr{background:var(--navy);color:#fff;padding:12px 16px;border-radius:8px;margin-bottom:16px}
.sec-hdr h3{font-size:13px;font-weight:700}
.sec-hdr p{font-size:11px;color:rgba(255,255,255,.7);margin-top:3px}
.sec-counter{font-size:10px;color:rgba(255,255,255,.5);margin-top:2px}

/* OPTS SCALE LABELS */
.scale-labels{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:8px}
.scale-lbl{text-align:center;font-size:9px;color:var(--text3);font-weight:600}

/* OPCIONAL */
.opt-section{border:1.5px solid var(--border);border-radius:8px;padding:14px;margin-bottom:16px}
.opt-section-title{font-size:12px;font-weight:700;color:var(--text2);margin-bottom:4px}
.opt-toggle{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.opt-toggle label{font-size:13px;color:var(--text)}
.toggle-btns{display:flex;gap:6px}
.toggle-btn{padding:5px 16px;border-radius:6px;border:1.5px solid var(--border);font-size:12px;font-weight:600;cursor:pointer;background:var(--white);color:var(--text2)}
.toggle-btn.active{background:var(--navy);color:#fff;border-color:var(--navy)}

/* BOTONES NAV */
.nav-btns{display:flex;gap:10px;justify-content:space-between;margin-top:8px}
.btn{padding:12px 24px;border-radius:8px;border:none;font-size:14px;font-weight:700;cursor:pointer;font-family:var(--font);transition:opacity .15s}
.btn:hover{opacity:.88}
.btn-navy{background:var(--navy);color:#fff}
.btn-outline{background:var(--white);color:var(--navy);border:1.5px solid var(--border)}
.btn-green{background:var(--green);color:#fff}
.btn:disabled{opacity:.4;cursor:not-allowed}

/* PANTALLA INICIO */
#screen-inicio .logo{text-align:center;padding:30px 0 20px}
#screen-inicio .logo h1{font-size:22px;font-weight:800;color:var(--navy)}
#screen-inicio .logo p{font-size:13px;color:var(--text2);margin-top:6px}
.instrucciones{background:#EFF6FF;border:1px solid #BFDBFE;border-radius:8px;padding:14px 16px;margin-bottom:16px;font-size:13px;line-height:1.7;color:#1E40AF}
.instrucciones strong{display:block;margin-bottom:4px;font-size:13px}

/* PANTALLA GRACIAS */
#screen-gracias{text-align:center;padding:40px 20px}
#screen-gracias .icon{font-size:56px;margin-bottom:16px}
#screen-gracias h2{font-size:22px;font-weight:800;color:var(--navy);margin-bottom:8px}
#screen-gracias p{font-size:14px;color:var(--text2);line-height:1.6;margin-bottom:8px}

/* GUIA I ATS */
.ats-q{margin-bottom:12px}
.ats-q p{font-size:13px;color:var(--text);margin-bottom:6px;line-height:1.5}
.ats-opts{display:flex;gap:8px}
.ats-opt{padding:6px 18px;border:1.5px solid var(--border);border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;background:var(--white);color:var(--text2)}
.ats-opt.sel-si{border-color:var(--red);background:var(--red);color:#fff}
.ats-opt.sel-no{border-color:var(--green);background:var(--green);color:#fff}

/* TOAST */
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#0F172A;color:#fff;padding:10px 20px;border-radius:8px;font-size:13px;font-weight:600;z-index:999;display:none}
.toast.show{display:block}

/* SPINNER */
.spinner{display:inline-block;width:18px;height:18px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:6px}
@keyframes spin{to{transform:rotate(360deg)}}

@media(max-width:500px){
  .q-opts{grid-template-columns:1fr 1fr;gap:6px}
  .scale-labels{display:none}
}
</style>
</head>
