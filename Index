function renderATS() {
  renderATSSec('ats-sec1', ATS_SEC1, 1);
  renderATSSec('ats-sec2', ATS_SEC2, 2);
  renderATSSec('ats-sec3', ATS_SEC3, 3);
  renderATSSec('ats-sec4', ATS_SEC4, 4);
}

function renderATSSec(elId, pregs, sec) {
  const el = document.getElementById(elId);
  el.innerHTML = pregs.map((p,i)=>{
    const key=`s${sec}_${i}`;
    return `<div class="ats-q">
      <p>${p}</p>
      <div class="ats-opts">
        <button class="ats-opt" onclick="answerATS('${key}','si',this)">Sí</button>
        <button class="ats-opt" onclick="answerATS('${key}','no',this)">No</button>
      </div>
    </div>`;
  }).join('');
}

function answerATS(key, val, btn) {
  atsAns[key] = val;
  const parent = btn.parentElement;
  parent.querySelectorAll('.ats-opt').forEach(b=>b.className='ats-opt');
  btn.classList.add(val==='si'?'sel-si':'sel-no');
  // Si alguna de sec1 es Sí, mostrar secs 2-3-4
  const sec1Keys = ATS_SEC1.map((_,i)=>`s1_${i}`);
  const algSi = sec1Keys.some(k=>atsAns[k]==='si');
  document.getElementById('ats-secs-2-3-4').style.display = algSi?'block':'none';
}

function finalizarATS() {
  // Verificar sec1 contestada
  const sec1Done = ATS_SEC1.every((_,i)=>atsAns[`s1_${i}`]);
  if(!sec1Done){ toast('Responde todas las preguntas de la sección I'); return; }
  // Construir secciones G2 + G3
  buildSecciones();
  secIdx = 0;
  renderSeccion();
  show('screen-preguntas');
  setProgress(10);
}

